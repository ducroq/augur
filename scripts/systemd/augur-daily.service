[Unit]
Description=Augur daily model update (LGBM shadow + ARF + dashboard push)
Documentation=https://github.com/ducroq/augur/issues/12
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jeroen
Group=jeroen
WorkingDirectory=/home/jeroen/local_dev/augur

# Wait for EDH to publish a USABLE dataset before running. Rewritten
# 2026-09-01: readiness is now a content contract read from
# data_quality_report.json (report strictly newer than the last consumed, and
# the entsoe dataset at full size vs the median of recent publishes), not a
# clock window. GitHub defers this cron unpredictably -- observed starts span
# 00:18-21:14 UTC -- so the old fixed 16:30+4h window could shut before a
# perfectly good publish landed. Polls to a 03:00 UTC deadline, then proceeds
# anyway: this gate never fails closed.
ExecStartPre=/home/jeroen/local_dev/augur/scripts/wait_for_edh.sh

# Main job: the existing script, untouched.
#
# NOTE (corrected 2026-08-31): the StandardOutput/StandardError= lines below
# redirect to the logfile and thereby OVERRIDE systemd's default journal
# capture. This comment previously claimed output lands in the logfile "AND"
# the journal; it does not. `journalctl -u augur-daily.service` carries only
# systemd's own lifecycle lines — start, exit code, timeout — and never a byte
# of script output. scripts/alert_failure.sh was written against the wrong
# claim and shipped a diagnostics-free alert email once before it was caught.
ExecStart=/home/jeroen/local_dev/augur/scripts/daily_update.sh

StandardOutput=append:/home/jeroen/local_dev/augur/logs/daily_update.log
StandardError=append:/home/jeroen/local_dev/augur/logs/daily_update.log

# Match the umask the script itself sets at the top.
UMask=0027

# TimeoutStartSec covers ExecStartPre + ExecStart per systemd semantics. The
# gate now polls from 16:30 UTC to a 03:00 UTC deadline (10.5h) and the run
# itself needs up to 90 min, so 12.5h. NOTE for whoever reads `systemctl
# status` and worries: this unit being "activating" for many hours overnight is
# NORMAL — it is waiting on EDH, not hung. It also means OnFailure= cannot fire
# for a stall until the timeout expires; the 06:00 UTC heartbeat is what covers
# that gap.
TimeoutStartSec=45000

[Install]
WantedBy=multi-user.target
